# Server-side only (Vercel serverless functions in api/) — do NOT prefix
# with VITE_, that would expose them to the browser bundle. Set these as
# environment variables in the Vercel project dashboard for production,
# and in a local .env for `vercel dev` / npm run ingest.
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_knowledge
GROQ_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
